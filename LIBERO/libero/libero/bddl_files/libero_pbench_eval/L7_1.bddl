(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language L7_1Pick the salad dressing and put it into the basket)
    (:regions
      (chocolate_pudding_1_init_region
          (:target living_room_table)
          (:ranges (
              (0.075 -0.225 0.125 -0.175)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_1_init_region
          (:target living_room_table)
          (:ranges (
              (-0.125 -0.175 -0.075 -0.125)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_2_init_region
          (:target living_room_table)
          (:ranges (
              (-0.125 0.025 -0.075 0.075)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (new_salad_dressing_1_init_region
          (:target living_room_table)
          (:ranges (
              (0.1 -0.025 0.12 0.025)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_init_region
          (:target living_room_table)
          (:ranges (
              (0.05 0.2 0.1 0.25)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
          (:ranges (
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    akita_black_bowl_1 akita_black_bowl_2 - akita_black_bowl
    new_salad_dressing_1 - new_salad_dressing
    chocolate_pudding_1 - chocolate_pudding
    basket_1 - basket
  )

  (:obj_of_interest
    new_salad_dressing_1
    basket_1
  )

  (:init
    (on chocolate_pudding_1 living_room_table_chocolate_pudding_1_init_region)
    (on akita_black_bowl_1 living_room_table_akita_black_bowl_1_init_region)
    (on akita_black_bowl_2 living_room_table_akita_black_bowl_2_init_region)
    (on new_salad_dressing_1 living_room_table_new_salad_dressing_1_init_region)
    (on basket_1 living_room_table_basket_1_init_region)
  )

  (:goal
    (And (in new_salad_dressing_1 basket_1_contain_region))
  )

)
