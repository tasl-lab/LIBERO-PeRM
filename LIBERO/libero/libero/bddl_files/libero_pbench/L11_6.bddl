(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the book in the middle and place it on the cabinet shelf)
    (:regions
      (bin_region
          (:target study_table)
          (:ranges (
              (-0.01 0.25 0.01 0.27)
            )
          )
      )
      (bbq_sauce_1_init_region
          (:target study_table)
          (:ranges (
              (0.06 -0.09 0.09 -0.06)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (bbq_sauce_2_init_region
          (:target study_table)
          (:ranges (
              (-0.055 -0.08 0.0 -0.07)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (yellow_book_right_init_region
          (:target study_table)
          (:ranges (
              (0.130000000000000005 0.0010 0.13001 0.00101)
            )
          )
          (:yaw_rotation (
              (0.7 0.7)
            )
          )
      ) 
      (red_yellow_book_init_region
          (:target study_table)
          (:ranges (
              (-0.050000000000000005 -0.14 -0.04 -0.13)
            )
          )
          (:yaw_rotation (
              (0.7 0.7)
            )
          )
      )
      (black_book_init_region
          (:target study_table)
          (:ranges (
              (0.19 -0.16 0.210000000000000005 -0.13999999999999999)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cylinder_init_region
          (:target study_table)
          (:ranges (
              (-0.075 -0.225 -0.05 -0.2)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      ) 
      (contain_region
          (:target basket_1)
      )
      (top_side
          (:target white_storage_box_1)

      )
    )

  (:fixtures
    study_table - study_table
    white_storage_box_1 - white_storage_box
  )

  (:objects
    bbq_sauce_1 bbq_sauce_2 - bbq_sauce
    plate_1 - plate
    basket_1 - basket
  )

  (:obj_of_interest
    plate_1
    bbq_sauce_1
    bbq_sauce_2
    basket_1
  )

  (:init
    (On basket_1 study_table_bin_region)
    (On bbq_sauce_1 study_table_bbq_sauce_1_init_region)
    (On bbq_sauce_2 study_table_bbq_sauce_2_init_region)
    (On plate_1 white_storage_box_1_top_side)
    (On white_storage_box_1 study_table_cylinder_init_region)
    
  )

  (:goal
    (And (In bbq_sauce_1 basket_1_contain_region) (In bbq_sauce_2 basket_1_contain_region) (In plate_1 basket_1_contain_region))
  )

)
