(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the salad dressing by its top and place it in the basket)
    (:regions
      (basket_init_region
          (:target living_room_table)
          (:ranges (
              (0.05 0.20 0.10 0.25)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (chocolate_pudding_init_region
          (:target living_room_table)
          (:ranges (
              (0.12 -0.20 0.17 -0.15)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_right_init_region
          (:target living_room_table)
          (:ranges (
              (-0.08 0.06 -0.03 0.11)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_left_init_region
          (:target living_room_table)
          (:ranges (
              (-0.16 -0.14 -0.11 -0.09)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (salad_dressing_init_region
          (:target living_room_table)
          (:ranges (
              (0.1 -0.025 0.12 0.025)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    yellow_bowl_1 red_bowl_1 - yellow_bowl
    new_salad_dressing_1 - new_salad_dressing
    butter_1 - butter
    basket_1 - basket
  )

  (:obj_of_interest
    new_salad_dressing_1
    basket_1
  )

  (:init
    (On butter_1 living_room_table_chocolate_pudding_init_region)
    (On red_bowl_1 living_room_table_akita_black_bowl_left_init_region)
    (On yellow_bowl_1 living_room_table_akita_black_bowl_right_init_region)
    (On new_salad_dressing_1 living_room_table_salad_dressing_init_region)
    (On basket_1 living_room_table_basket_init_region)
  )

  (:goal
    (And (In new_salad_dressing_1 basket_1_contain_region))
  )

)
