(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick the plate with load and put it on the microwave)
    (:regions
      (cylinder_init_region
          (:target kitchen_table)
          (:ranges (
              (0.04 -0.29 0.05 -0.27)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )

      (obstacle_cylinder_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.16 -0.2 -0.15 -0.12)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )

      (alphabet_soup_init_region
          (:target kitchen_table)
          (:ranges (
              (0.1 0.19 0.14 0.24)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (microwave_init_region
          (:target kitchen_table)
          (:ranges (
              (0.07 0.05 0.08 0.07)
            )
          )
          (:yaw_rotation (
              (3.1415926 3.1415926)
            )
          )
      )
    )


  (:fixtures
    kitchen_table - kitchen_table
    microwave_1 - microwave
  )

  (:objects
    plate_1 - plate
    akita_black_bowl_1 - akita_black_bowl
    cylinder_a_1 - cylinder_a
    cylinder_b_1 - cylinder_b
    alphabet_soup_1 - alphabet_soup
  )

  (:obj_of_interest
    plate_1
    akita_black_bowl_1
    microwave_1
    cylinder_b_1
  )

  (:init
    (On cylinder_a_1 kitchen_table_cylinder_init_region)
    (On cylinder_b_1 kitchen_table_obstacle_cylinder_init_region)
    (On alphabet_soup_1 kitchen_table_alphabet_soup_init_region)
    (On plate_1 cylinder_a_1)
    (On microwave_1 kitchen_table_microwave_init_region)
    (On akita_black_bowl_1 plate_1)
  )

  (:goal
    (And
      (On plate_1 microwave_1)
      (On akita_black_bowl_1 plate_1)
    )
  )
)
