(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language Prepare a food and a drink in basket)
    (:regions
      (bin_region
          (:target floor)
          (:ranges (
              (-0.01 0.25 0.01 0.27)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (target_object_region
          (:target floor)
          (:ranges (
              (-0.145 -0.265 -0.095 -0.215)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (other_object_region_0
          (:target floor)
          (:ranges (
              (0.025 -0.075 0.07500000000000001 -0.02500000000000001)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (other_object_region_1
          (:target floor)
          (:ranges (
              (-0.175 0.034999999999999996 -0.125 0.08499999999999999)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (other_object_region_2
          (:target floor)
          (:ranges (
              (0.07500000000000001 -0.225 0.125 -0.17500000000000002)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (other_object_region_3
          (:target floor)
          (:ranges (
              (0.125 0.0049999999999999975 0.175 0.055)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (other_object_region_4
          (:target floor)
          (:ranges (
              (-0.225 -0.10500000000000001 -0.17500000000000002 -0.055)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (contain_region
          (:target basket_1)
          (:ranges (
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    basket_1 - basket
    salad_dressing_1 - salad_dressing
    cream_cheese_1 - cream_cheese
    milk_1 - milk
    yellow_moka_pot_1 - yellow_moka_pot
    cookies_1 - cookies
  )

  (:obj_of_interest
    alphabet_soup_1
    basket_1
  )

  (:init
    (on alphabet_soup_1 floor_target_object_region)
    (on salad_dressing_1 floor_other_object_region_1)
    (on yellow_moka_pot_1 floor_other_object_region_0)
    (on milk_1 floor_other_object_region_3)
    (on cream_cheese_1 floor_other_object_region_4)
    (on cookies_1 floor_other_object_region_2)
    (on basket_1 floor_bin_region)
  )

  (:goal
    (And (in milk_1 basket_1_contain_region) (in cream_cheese_1 basket_1_contain_region))
  )

)
