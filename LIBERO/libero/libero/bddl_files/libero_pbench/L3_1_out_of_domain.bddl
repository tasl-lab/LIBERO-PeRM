(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language Pick the salad dressing by its top and place it in the basket)
    (:regions
      (bin_region
          (:target floor)
          (:ranges (
              (-0.01 0.25 0.01 0.27)
            )
          )
      )
      (salad_dressing_region
          (:target floor)
          (:ranges (
              (-0.10 -0.05 -0.05 0.0)
            )
          )
      )
      (other_object_region_0
          (:target floor)
          (:ranges (
              (0.06 -0.10 0.11 -0.05)
            )
          )
      )
      (other_object_region_1
          (:target floor)
          (:ranges (
              (-0.14 0.06 -0.09 0.11)
            )
          )
      )
      (other_object_region_2
          (:target floor)
          (:ranges (
              (0.10 -0.20 0.15 -0.15)
            )
          )
      )
      (other_object_region_3
          (:target floor)
          (:ranges (
              (0.16 0.03 0.21 0.08)
            )
          )
      )
      (other_object_region_4
          (:target floor)
          (:ranges (
              (-0.20 -0.14 -0.15 -0.09)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    red_alphabet_soup_1 - red_alphabet_soup
    basket_1 - basket
    salad_dressing_1 - salad_dressing
    red_cream_cheese_1 - red_cream_cheese
    bigger_milk_1 - bigger_milk
    yellow_tomato_sauce_1 - yellow_tomato_sauce
    chocolate_pudding_1 - chocolate_pudding
  )

  (:obj_of_interest
    salad_dressing_1
    basket_1
  )

  (:init
    (On red_alphabet_soup_1 floor_other_object_region_0)
    (On salad_dressing_1 floor_salad_dressing_region)
    (On red_cream_cheese_1 floor_other_object_region_1)
    (On bigger_milk_1 floor_other_object_region_2)
    (On yellow_tomato_sauce_1 floor_other_object_region_3)
    (On chocolate_pudding_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
    (And (In salad_dressing_1 basket_1_contain_region))
  )

)
