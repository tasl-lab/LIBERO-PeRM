(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the bbq sauce in the basket)
    (:regions
      (basket_init_region
          (:target living_room_table)
          (:ranges (
              (-0.01 0.25 0.01 0.27)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (bbq_sauce_init_region
          (:target living_room_table)
          (:ranges (
              (0.025 -0.125 0.07500000000000001 -0.07500000000000001)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cream_cheese_init_region
          (:target living_room_table)
          (:ranges (
              (0.07500000000000001 -0.225 0.125 -0.17500000000000002)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (tomato_sauce_init_region
          (:target living_room_table)
          (:ranges (
              (-0.16 0.06 -0.11 0.11)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (butter_init_region
          (:target living_room_table)
          (:ranges (
              (-0.02 0.06 0.03 0.11)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ketchup_init_region
          (:target living_room_table)
          (:ranges (
              (-0.24 -0.30 -0.19 -0.25)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects

    yellow_tomato_sauce_1 - yellow_tomato_sauce
    bbq_sauce_1 - bbq_sauce
    chocolate_pudding_1 - chocolate_pudding
    basket_1 - basket
    wine_rack_1 - wine_rack
  )

  (:obj_of_interest
    bbq_sauce_1
    basket_1
  )

  (:init
    (On yellow_tomato_sauce_1 living_room_table_tomato_sauce_init_region)
    (On wine_rack_1 living_room_table_ketchup_init_region)
    (On bbq_sauce_1 living_room_table_bbq_sauce_init_region)
    (On chocolate_pudding_1 living_room_table_butter_init_region)
    (On basket_1 living_room_table_basket_init_region)
  )

  (:goal
    (And (In bbq_sauce_1 basket_1_contain_region) )
  )

)
