(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick the plate with a bowl on it)
    (:regions
      (cylinder_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.16 -0.38 -0.15 -0.37)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )

      (microwave_init_region
          (:target kitchen_table)
          (:ranges (
              (0.07 -0.03 0.08 -0.02)
            )
          )
          (:yaw_rotation (
              (3.1415926 3.1415926)
            )
          )
      )

      (white_yellow_mug_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.12500000000000001 0.07500000000000001 -0.075 0.125)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )

      (red_coffee_mug_init_region
          (:target kitchen_table)
          (:ranges (
              (0.20 -0.025 0.2200000000000002 0.025)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )

      (porcelain_mug_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.125 -0.175 -0.07500000000000001 -0.125)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )


  (:fixtures
    kitchen_table - kitchen_table
    microwave_1 - microwave
  )

  (:objects
    cylinder_a_1 - cylinder_a
    blue_plate_1 - blue_plate
    red_bowl_1 - red_bowl
    alphabet_soup_1 - alphabet_soup
    moka_pot_1 - moka_pot
    plate_1 - plate
  )

  (:obj_of_interest
    blue_plate_1
    red_bowl_1
    microwave_1
  )

  (:init

    (On plate_1 kitchen_table_white_yellow_mug_init_region)
    (On moka_pot_1 kitchen_table_red_coffee_mug_init_region)
    (On alphabet_soup_1 kitchen_table_porcelain_mug_init_region)
    (On cylinder_a_1 kitchen_table_cylinder_init_region)
    (On blue_plate_1 cylinder_a_1)
    (On red_bowl_1 blue_plate_1)
    (On microwave_1 kitchen_table_microwave_init_region)
  )

  (:goal
    (And
      (On blue_plate_1 microwave_1)
    )
  )
)
