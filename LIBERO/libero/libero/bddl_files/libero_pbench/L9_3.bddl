(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the ketchup in the top drawer of the cabinet)
    (:regions
      (basket_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.01 0.25 0.01 0.27)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (bbq_sauce_init_region
          (:target kitchen_table)
          (:ranges (
              (0.025 -0.035 0.07500000000000001 0.015500000000000001)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (white_cabinet_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.01 0.29 0.01 0.31)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.1449999999999999975 -0.02000000000000001 -0.095 0.020)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ketchup_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.225 -0.125 -0.17500000000000001 -0.07500000000000001)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.17500000000000001 -0.275 -0.125 -0.225)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    moka_pot_1 - moka_pot
    red_coffee_mug_1 - red_coffee_mug
    salad_dressing_1 - salad_dressing
    basket_1 - basket
    bbq_sauce_1 - bbq_sauce
  )

  (:obj_of_interest
    bbq_sauce_1
  )

  (:init
    (On moka_pot_1 kitchen_table_akita_black_bowl_init_region)
    (On red_coffee_mug_1 kitchen_table_plate_init_region)
    (On basket_1 kitchen_table_basket_init_region)
    (On salad_dressing_1 kitchen_table_ketchup_init_region)
    (On bbq_sauce_1 kitchen_table_bbq_sauce_init_region)

  )

  (:goal
    (And (In bbq_sauce_1 basket_1_contain_region) )
  )

)
