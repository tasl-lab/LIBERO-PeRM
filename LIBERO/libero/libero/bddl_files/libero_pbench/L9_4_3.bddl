(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the ketchup in the top drawer of the cabinet)
    (:regions
      (plate_1_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.1001 0.25 -0.1 0.27)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )

      (plate_2_init_region
          (:target kitchen_table)
          (:ranges (
              (0.1 0.25 0.1001 0.27)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
       (blue_plate_1_init_region
          (:target kitchen_table)
          (:ranges (
              (0.1 -0.27 0.1001 -0.25)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (bbq_sauce_init_region
          (:target kitchen_table)
          (:ranges (
              (0.025 -0.035 0.07500000000000001 0.015500000000000001)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (white_cabinet_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.01 0.29 0.01 0.31)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.1449999999999999975 -0.02000000000000001 -0.095 0.020)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ketchup_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.225 -0.125 -0.17500000000000001 -0.07500000000000001)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.17500000000000001 -0.275 -0.125 -0.225)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    ketchup_1 ketchup_2 - ketchup
    blue_ketchup_1 blue_ketchup_2 - blue_ketchup
    blue_plate_1 - blue_plate
    plate_1 plate_2 - plate

  )

  (:obj_of_interest
    ketchup_1
  )

  (:init
    (On ketchup_1 kitchen_table_akita_black_bowl_init_region)
    (On ketchup_2 kitchen_table_plate_init_region)
    (On plate_1 kitchen_table_plate_1_init_region)
    (On plate_2 kitchen_table_plate_2_init_region)
    (On blue_plate_1 kitchen_table_blue_plate_1_init_region)
    (On blue_ketchup_1 kitchen_table_ketchup_init_region)
    (On blue_ketchup_2 kitchen_table_bbq_sauce_init_region)

  )

  (:goal
    (And
    (On blue_ketchup_1 blue_plate_1)
    (On blue_ketchup_2 blue_plate_2)
    )
  )

)
