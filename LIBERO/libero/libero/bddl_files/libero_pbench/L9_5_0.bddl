(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the akita black bowl from the table and place it on the red_ramekin)
    (:regions
      (white_cabinet_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.01 0.29 0.01 0.31)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_cream_cheese_init_region
          (:target kitchen_table)
          (:ranges (
              (0.0049999999999999975 -0.12500000000000001 0.055 -0.075)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ketchup_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.20 0.05 -0.15 0.10)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_ramekin_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.07500000000000001 -0.275 -0.025 -0.225)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (top_side
          (:target white_cabinet_1)
      )
      (top_region
          (:target white_cabinet_1)
      )
      (middle_region
          (:target white_cabinet_1)
      )
      (bottom_region
          (:target white_cabinet_1)
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    white_cabinet_1 - white_cabinet
  )

  (:objects
    red_cream_cheese_1 - red_cream_cheese
    red_ramekin_1 - red_ramekin
    ketchup_1 - ketchup
  )

  (:obj_of_interest
    red_cream_cheese_1
    red_ramekin_1
  )

  (:init
    (On red_cream_cheese_1 kitchen_table_red_cream_cheese_init_region)
    (On red_ramekin_1 kitchen_table_red_ramekin_init_region)
    (On white_cabinet_1 kitchen_table_white_cabinet_init_region)
    (On ketchup_1 kitchen_table_ketchup_init_region)
    (Close white_cabinet_1_top_region)
  )

  (:goal
    (And
    (In red_cream_cheese_1 white_cabinet_1_top_region)
    (Close white_cabinet_1_top_region)
    )
  )

)

