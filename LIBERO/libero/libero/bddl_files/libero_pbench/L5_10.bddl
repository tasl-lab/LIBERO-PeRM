(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the cream cheese and put it on the plate)
    (:regions
      (plate_region
          (:target main_table)
          (:ranges (
              (0.05 0.19 0.07 0.21)
            )
          )
      )
      (next_to_plate_region
          (:target main_table)
          (:ranges (
              (0.0 0.3 0.02 0.32)
            )
          )
      )
      (box_region
          (:target main_table)
          (:ranges (
              (0.16 0.0 0.18 0.001)
            )
          )
      )
      (next_to_box_region
          (:target main_table)
          (:ranges (
              (0.12 -0.08 0.14 -0.06)
            )
          )
      )
      (cream_cheese_region
          (:target main_table)
          (:ranges (
              (-0.01 -0.15 -0.00 -0.14)
            )
          )
      )
      (ramekin_region
          (:target main_table)
          (:ranges (
              (-0.21 0.19 -0.19 0.21)
            )
          )
      )
      (next_to_ramekin_region
          (:target main_table)
          (:ranges (
              (-0.19 0.31 -0.17 0.33)
            )
          )
      )
      (table_center
          (:target main_table)
          (:ranges (
              (-0.1 -0.01 -0.05 0.01)
            )
          )
      )
      (table_front
          (:target main_table)
          (:ranges (
              (0.19 -0.01 0.21 0.01)
            )
          )
      )
      (cabinet_region
          (:target main_table)
          (:ranges (
              (0.02 -0.28 0.04 -0.26)
            )
          )
      )
      (stove_region
          (:target main_table)
          (:ranges (
              (-0.42 -0.15 -0.4 -0.13)
            )
          )
      )

      (top_side
          (:target white_storage_box_1)
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    main_table - table
    white_storage_box_1 - white_storage_box
    flat_stove_1 - flat_stove
  )

  (:objects
    white_porcelain_mug_1 - white_porcelain_mug
    cream_cheese_1 - cream_cheese
    wine_bottle_1 - wine_bottle
    yellow_moka_pot_1 - yellow_moka_pot
    plate_1 - plate
  )

  (:obj_of_interest
    cream_cheese_1
    plate_1
  )

  (:init
    (On white_porcelain_mug_1 white_storage_box_1_top_side)
    (On wine_bottle_1 main_table_cream_cheese_region)
    (On plate_1 main_table_plate_region)
    (On cream_cheese_1 main_table_box_region)
    (On yellow_moka_pot_1 main_table_ramekin_region)
    (On white_storage_box_1 main_table_cabinet_region)
    (On flat_stove_1 main_table_stove_region)
  )

  (:goal
    (And (On white_porcelain_mug_1 plate_1))
  )

)

