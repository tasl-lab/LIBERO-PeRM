(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language Pick the alphabet soup and place it in the red_basket)
    (:regions
      (bin_region
          (:target floor)
          (:ranges (
              (-0.01 0.25 0.01 0.27)
            )
          )
      )
      (target_object_region
          (:target floor)
          (:ranges (
              (-0.145 -0.265 -0.095 -0.215)
            )
          )
      )
      (other_object_region_0
          (:target floor)
          (:ranges (
              (0.025 -0.125 0.07500000000000001 -0.07500000000000001)
            )
          )
      )
      (other_object_region_1
          (:target floor)
          (:ranges (
              (-0.275 0.134999999999999996 -0.225 0.18499999999999999)
            )
          )
      )
      (other_object_region_2
          (:target floor)
          (:ranges (
              (0.07500000000000001 -0.225 0.125 -0.17500000000000002)
            )
          )
      )
      (other_object_region_3
          (:target floor)
          (:ranges (
              (0.125 0.0049999999999999975 0.175 0.055)
            )
          )
      )
      (other_object_region_4
          (:target floor)
          (:ranges (
              (-0.225 -0.10500000000000001 -0.17500000000000002 -0.055)
            )
          )
      )
      (contain_region
          (:target red_basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    green_bbq_sauce_1 - green_bbq_sauce
    red_basket_1 - red_basket
    salad_dressing_1 - salad_dressing
    cream_cheese_1 - cream_cheese
    milk_1 - milk
    yellow_moka_pot_1 - yellow_moka_pot
    cookies_1 - cookies
  )

  (:obj_of_interest
    salad_dressing_1
    red_basket_1
  )

  (:init
    (On green_bbq_sauce_1 floor_target_object_region)
    (On salad_dressing_1 floor_other_object_region_0)
    (On yellow_moka_pot_1 floor_other_object_region_1)
    (On milk_1 floor_other_object_region_2)
    (On cream_cheese_1 floor_other_object_region_3)
    (On cookies_1 floor_other_object_region_4)
    (On red_basket_1 floor_bin_region)
  )

  (:goal
    (And
    (In salad_dressing_1 red_basket_1_contain_region)
    )
  )

)
