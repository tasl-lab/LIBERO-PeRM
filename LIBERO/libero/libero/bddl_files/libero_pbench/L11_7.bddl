(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the book in the middle and place it on the cabinet shelf)
    (:regions
      (yellow_book_right_init_region
          (:target study_table)
          (:ranges (
              (0.130000000000000005 0.0010 0.13001 0.00101)
            )
          )
          (:yaw_rotation (
              (0.7 0.7)
            )
          )
      )
      (yellow_book_left_init_region
          (:target study_table)
          (:ranges (
              (-0.060000000000000005 -0.01 -0.04 0.01)
            )
          )
          (:yaw_rotation (
              (0.7 0.7)
            )
          )
      )
      (red_yellow_book_init_region
          (:target study_table)
          (:ranges (
              (-0.050000000000000005 -0.14 -0.04 -0.13)
            )
          )
          (:yaw_rotation (
              (0.7 0.7)
            )
          )
      )
      (black_book_init_region
          (:target study_table)
          (:ranges (
              (0.19 -0.16 0.210000000000000005 -0.13999999999999999)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (wooden_two_layer_shelf_init_region
          (:target study_table)
          (:ranges (
              (-0.01 0.27 0.01 0.29000000000000004)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (top_side
          (:target wooden_two_layer_shelf_1)
      )
      (top_region
          (:target wooden_two_layer_shelf_1)
      )
      (bottom_region
          (:target wooden_two_layer_shelf_1)
      )
    )

  (:fixtures
    study_table - study_table
    wooden_two_layer_shelf_1 - wooden_two_layer_shelf
  )

  (:objects
    black_book_1 - black_book
    red_yellow_book_side_1 - red_yellow_book_side
    yellow_book_1 - yellow_book
    yellow_book_side_1 - yellow_book_side
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
  )

  (:obj_of_interest
    black_book_1
    wooden_two_layer_shelf_1
  )

  (:init
    (On wooden_two_layer_shelf_1 study_table_wooden_two_layer_shelf_init_region)
    (On black_book_1 study_table_yellow_book_right_init_region)
    (On red_yellow_book_side_1 study_table_red_yellow_book_init_region)
    (On yellow_book_1 study_table_black_book_init_region)
    (On glazed_rim_porcelain_ramekin_1 study_table_yellow_book_left_init_region )
  )

  (:goal
    (And
    (On black_book_1 wooden_two_layer_shelf_1_top_side)
    (On red_yellow_book_side_1 wooden_two_layer_shelf_1_top_side)
    )
  )

)
