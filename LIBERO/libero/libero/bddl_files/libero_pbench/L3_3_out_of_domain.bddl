(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language Put butter and chocolate_pudding into the basket)
    (:regions
      (bin_region
          (:target floor)
          (:ranges (
              (-0.01 0.25 0.01 0.27)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (target_object_region
          (:target floor)
          (:ranges (
              (-0.145 -0.265 -0.095 -0.215)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (other_object_region_0
          (:target floor)
          (:ranges (
              (0.025 -0.125 0.07500000000000001 -0.07500000000000001)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (other_object_region_1
          (:target floor)
          (:ranges (
              (-0.175 0.034999999999999996 -0.125 0.08499999999999999)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (other_object_region_2
          (:target floor)
          (:ranges (
              (0.07500000000000001 -0.225 0.125 -0.17500000000000002)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (other_object_region_3
          (:target floor)
          (:ranges (
              (0.125 0.0049999999999999975 0.175 0.055)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (other_object_region_4
          (:target floor)
          (:ranges (
              (-0.225 -0.10500000000000001 -0.17500000000000002 -0.055)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (contain_region
          (:target basket_1)
          (:ranges (
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    green_butter_1 - green_butter
    basket_1 - basket
    red_cream_cheese_1 - red_cream_cheese
    chocolate_pudding_1 - chocolate_pudding
    blue_ketchup_1 - blue_ketchup
    green_chocolate_pudding_1 - green_chocolate_pudding
    yellow_milk_1 - yellow_milk
  )

  (:obj_of_interest
    green_chocolate_pudding_1
    green_butter_1
    basket_1
  )

  (:init
    (on green_butter_1 floor_target_object_region)
    (on red_cream_cheese_1 floor_other_object_region_2)
    (on blue_ketchup_1 floor_other_object_region_3)
    (on chocolate_pudding_1 floor_other_object_region_1)
    (on yellow_milk_1 floor_other_object_region_0)
    (on green_chocolate_pudding_1 floor_other_object_region_4)
    (on basket_1 floor_bin_region)
  )

  (:goal
    (And (in green_chocolate_pudding_1 basket_1_contain_region) (in green_butter_1 basket_1_contain_region))
  )

)
