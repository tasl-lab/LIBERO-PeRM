(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the ketchup and place it in the basket)
    (:regions
      (bin_region
          (:target kitchen_table)
          (:ranges (
              (-0.025 0.225 0.025 0.275)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (target_object_region
          (:target kitchen_table)
          (:ranges (
              (0.0215 -0.2203 0.0315 -0.2103)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_0
          (:target kitchen_table)
          (:ranges (
              (0.13 -0.1 0.18 -0.05)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_1
          (:target kitchen_table)
          (:ranges (
              (0.13 0.05 0.18 0.1)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_2
          (:target kitchen_table)
          (:ranges (
              (0.1 -0.22 0.15 -0.17)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    ketchup_1 - ketchup
    basket_1 - basket
    bbq_sauce_1 - bbq_sauce
    green_butter_1 - green_butter
    alphabet_soup_1 - alphabet_soup
  )

  (:obj_of_interest
    ketchup_1
    basket_1
  )

  (:init
    (On ketchup_1 kitchen_table_target_object_region)
    (On bbq_sauce_1 kitchen_table_other_object_region_0)
    (On green_butter_1 kitchen_table_other_object_region_1)
    (On alphabet_soup_1 kitchen_table_other_object_region_2)
    (On basket_1 kitchen_table_bin_region)
  )

  (:goal
    (And (In ketchup_1 basket_1_contain_region))
  )

)
