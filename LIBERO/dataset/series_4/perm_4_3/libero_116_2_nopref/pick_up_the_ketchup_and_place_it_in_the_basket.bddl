(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the ketchup and place it in the basket)
    (:regions
      (bin_region
          (:target main_table)
          (:ranges (
              (-0.025 0.2 0.025 0.25)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (target_object_region
          (:target main_table)
          (:ranges (
              (-0.1052 -0.2438 -0.0952 -0.2338)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_0
          (:target main_table)
          (:ranges (
              (0.13 -0.1 0.18 -0.05)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_1
          (:target main_table)
          (:ranges (
              (0.13 0.05 0.18 0.1)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_2
          (:target main_table)
          (:ranges (
              (0.1 -0.22 0.15 -0.17)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    ketchup_1 - ketchup
    basket_1 - basket
    moka_pot_1 - moka_pot
    alphabet_soup_1 - alphabet_soup
    cream_cheese_1 - cream_cheese
  )

  (:obj_of_interest
    ketchup_1
    basket_1
  )

  (:init
    (On ketchup_1 main_table_target_object_region)
    (On moka_pot_1 main_table_other_object_region_0)
    (On alphabet_soup_1 main_table_other_object_region_1)
    (On cream_cheese_1 main_table_other_object_region_2)
    (On basket_1 main_table_bin_region)
  )

  (:goal
    (And (In ketchup_1 basket_1_contain_region))
  )

)
