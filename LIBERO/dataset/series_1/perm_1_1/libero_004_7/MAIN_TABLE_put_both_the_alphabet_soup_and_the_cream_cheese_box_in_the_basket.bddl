(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put both the alphabet soup and the cream cheese box in the basket)
    (:regions
      (basket_init_region
          (:target main_table)
          (:ranges (
              (-0.065 0.20 -0.015 0.25)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (alphabet_soup_init_region
          (:target main_table)
          (:ranges (
              (0.06 -0.05 0.11 0.0)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cream_cheese_init_region
          (:target main_table)
          (:ranges (
              (0.10 -0.22 0.15 -0.17)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (bbq_sauce_init_region
          (:target main_table)
          (:ranges (
              (-0.15 0.01 -0.10 0.06)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (butter_init_region
          (:target main_table)
          (:ranges (
              (-0.20 -0.22 -0.15 -0.17)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    cream_cheese_1 - cream_cheese
    bbq_sauce_1 - bbq_sauce
    butter_1 - butter
    basket_1 - basket
  )

  (:obj_of_interest
    alphabet_soup_1
    cream_cheese_1
    basket_1
  )

  (:init
    (On alphabet_soup_1 main_table_alphabet_soup_init_region)
    (On cream_cheese_1 main_table_cream_cheese_init_region)
    (On bbq_sauce_1 main_table_bbq_sauce_init_region)
    (On butter_1 main_table_butter_init_region)
    (On basket_1 main_table_basket_init_region)
  )

  (:goal
    (And (In alphabet_soup_1 basket_1_contain_region) (In cream_cheese_1 basket_1_contain_region))
  )

)
