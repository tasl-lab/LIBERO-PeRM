(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick the black book and place it in the basket)
    (:regions
      (basket_init_region
          (:target study_table)
          (:ranges (
              (-0.01 0.25 0.01 0.27)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (black_book_init_region
          (:target study_table)
          (:ranges (
              (0.005 -0.055 0.055 -0.005)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (alphabet_soup_init_region
          (:target study_table)
          (:ranges (
              (-0.175 0.035 -0.125 0.085)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cream_cheese_init_region
          (:target study_table)
          (:ranges (
              (0.10 -0.20 0.15 -0.15)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (popcorn_init_region
          (:target study_table)
          (:ranges (
              (-0.20 -0.20 -0.15 -0.15)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    study_table - study_table
  )

  (:objects
    black_book_1 - black_book
    alphabet_soup_1 - alphabet_soup
    cream_cheese_1 - cream_cheese
    popcorn_1 - popcorn
    basket_1 - basket
  )

  (:obj_of_interest
    black_book_1
    basket_1
  )

  (:init
    (On black_book_1 study_table_black_book_init_region)
    (On alphabet_soup_1 study_table_alphabet_soup_init_region)
    (On cream_cheese_1 study_table_cream_cheese_init_region)
    (On popcorn_1 study_table_popcorn_init_region)
    (On basket_1 study_table_basket_init_region)
  )

  (:goal
    (And (In black_book_1 basket_1_contain_region))
  )

)
