(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the blue ketchup and place it in the basket)
    (:regions
      (basket_init_region (:target living_room_table) (:ranges ((-0.01 0.25 0.01 0.27))) (:yaw_rotation ((0.0 0.0))))
      (blue_ketchup_init_region (:target living_room_table) (:ranges ((-0.0555 -0.1691 -0.0455 -0.1591))) (:yaw_rotation ((0.0 0.0))))
      (ketchup_init_region (:target living_room_table) (:ranges ((-0.055 -0.075 -0.045 -0.065))) (:yaw_rotation ((0.0 0.0))))
      (butter_init_region (:target living_room_table) (:ranges ((-0.2523 -0.0136 -0.2023 0.0364))) (:yaw_rotation ((0.0 0.0))))
      (milk_init_region (:target living_room_table) (:ranges ((0.1 -0.1 0.15 -0.05))) (:yaw_rotation ((0.0 0.0))))
      (contain_region (:target basket_1))
    )
  (:fixtures living_room_table - living_room_table)
  (:objects
    blue_ketchup_1 - blue_ketchup
    ketchup_1 - ketchup
    butter_1 - butter
    milk_1 - milk
    basket_1 - basket
  )
  (:obj_of_interest blue_ketchup_1 basket_1)
  (:init
    (On blue_ketchup_1 living_room_table_blue_ketchup_init_region)
    (On ketchup_1 living_room_table_ketchup_init_region)
    (On butter_1 living_room_table_butter_init_region)
    (On milk_1 living_room_table_milk_init_region)
    (On basket_1 living_room_table_basket_init_region)
  )
  (:goal (And (In blue_ketchup_1 basket_1_contain_region)))
)
