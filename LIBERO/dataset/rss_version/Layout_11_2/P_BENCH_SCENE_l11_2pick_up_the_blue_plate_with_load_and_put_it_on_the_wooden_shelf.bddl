(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up a book and place it on the right region of the caddy)
    (:regions
      (yellow_book_right_init_region
          (:target study_table)
          (:ranges (
              (0.04 -0.01 0.06 0.01)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (yellow_book_left_init_region
          (:target study_table)
          (:ranges (
              (-0.01 -0.26 0.01 -0.24)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cylinder_b_init_region
          (:target study_table)
          (:ranges (
              (0.09 -0.16 0.11 -0.13999999999999999)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (wooden_two_layer_shelf_init_region
          (:target study_table)
          (:ranges (
              (0.04 0.27 0.06 0.29000000000000004)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (desk_caddy_init_region
          (:target study_table)
          (:ranges (
              (-0.1 -0.14 -0.099 -0.139)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (desk_caddy_front_left_contain_region
          (:target study_table)
          (:ranges (
              (0.025 -0.175 0.075 -0.125)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (desk_caddy_right_region
          (:target study_table)
          (:ranges (
              (0.05 0.1 0.15 0.2)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (right_contain_region
          (:target desk_caddy_1)
      )
      (left_contain_region
          (:target desk_caddy_1)
      )
      (back_contain_region
          (:target desk_caddy_1)
      )
      (front_contain_region
          (:target desk_caddy_1)
      )
    (top_side
          (:target wooden_shelf_1)
      )
    )

  (:fixtures
    study_table - study_table
    wooden_shelf_1 - wooden_shelf
  )

  (:objects
    cylinder_b_1 - cylinder_b
    yellow_book_1 yellow_book_2 - yellow_book
    cylinder_c_1 - cylinder_c
    red_bowl_1 - red_bowl
    blue_plate_1 - blue_plate
  )

  (:obj_of_interest
    blue_plate_1
  )

  (:init
    (On yellow_book_2 study_table_yellow_book_left_init_region)
    (On cylinder_b_1 study_table_cylinder_b_init_region)
    (On cylinder_c_1 study_table_desk_caddy_init_region)
    (On blue_plate_1 cylinder_c_1)
    (On red_bowl_1 blue_plate_1)
    (on wooden_shelf_1 study_table_desk_caddy_right_region)
  )

  (:goal
    (And (On blue_plate_1 wooden_shelf_1_top_side))
  )

)
