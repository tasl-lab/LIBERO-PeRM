(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language L2_1Pick the mug and put it on the plate)
    (:regions
      (plate_1_init_region
          (:target living_room_table)
          (:ranges (
              (0.05 -0.2 0.1 -0.15)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_2_init_region
          (:target living_room_table)
          (:ranges (
              (0.05 0.15 0.1 0.2)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_1_init_region
          (:target living_room_table)
          (:ranges (
              (-0.2 -0.15 -0.15 -0.1)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (white_yellow_mug_1_init_region
          (:target living_room_table)
          (:ranges (
              (-0.2 0.1 -0.15 0.15)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_mug_1_init_region
          (:target living_room_table)
          (:ranges (
              (-0.1 -0.025 -0.05 0.025)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    porcelain_mug_1 - porcelain_mug
    red_coffee_mug_1 - red_coffee_mug
    white_yellow_mug_1 - white_yellow_mug
    plate_1 plate_2 plate_3 - plate
  )

  (:obj_of_interest
    porcelain_mug_1
    plate_1
  )

  (:init
    (on plate_1 living_room_table_plate_1_init_region)
    (on plate_2 living_room_table_plate_2_init_region)
    (on red_coffee_mug_1 living_room_table_red_coffee_mug_1_init_region)
    (on white_yellow_mug_1 living_room_table_white_yellow_mug_1_init_region)
    (on porcelain_mug_1 living_room_table_porcelain_mug_1_init_region)
  )

  (:goal
    (And (on porcelain_mug_1 plate_1))
  )

)
