(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language L11_6Put all BBQ sauces and the plate into the basket)
    (:regions
      (bin_region
          (:target study_table)
          (:ranges (
              (-0.01 0.25 0.01 0.27)
            )
          )
      )
      (bbq_sauce_1_init_region
          (:target study_table)
          (:ranges (
              (0.06 -0.09 0.09 -0.06)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (bbq_sauce_2_init_region
          (:target study_table)
          (:ranges (
              (-0.055 -0.08 -0.03 -0.07)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cylinder_init_region
          (:target study_table)
          (:ranges (
              (0.0 -0.2 0.05 -0.18)
            )
          )
          (:yaw_rotation (
              (1.57 1.58)
            )
          )
      ) 
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    study_table - study_table
  )

  (:objects
    cylinder_c_1 - cylinder_c
    bbq_sauce_1 bbq_sauce_2 - bbq_sauce
    plate_1 - plate
    basket_1 - basket
  )

  (:obj_of_interest
    plate_1
    bbq_sauce_1
    bbq_sauce_2
    basket_1
  )

  (:init
    (On basket_1 study_table_bin_region)
    (On bbq_sauce_1 study_table_bbq_sauce_1_init_region)
    (On plate_1 cylinder_c_1)
    (On cylinder_c_1 study_table_cylinder_init_region)
    
  )

  (:goal
    (And (In bbq_sauce_1 basket_1_contain_region)(In plate_1 basket_1_contain_region))
  )



)
