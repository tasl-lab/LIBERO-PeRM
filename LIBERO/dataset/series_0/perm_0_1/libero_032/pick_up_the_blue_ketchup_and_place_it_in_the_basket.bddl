(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the blue ketchup and place it in the basket)
    (:regions
      (basket_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.01 0.29 0.01 0.31)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (blue_ketchup_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.045 -0.07500000000000001 0.005 -0.025)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (wine_bottle_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.175 0.025 -0.125 0.07500000000000001)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ketchup_init_region
          (:target kitchen_table)
          (:ranges (
              (0.07 -0.07500000000000001 0.12 -0.025)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    blue_ketchup_1 - blue_ketchup
    basket_1 - basket
    wine_bottle_1 - wine_bottle
    ketchup_1 - ketchup
  )

  (:obj_of_interest
    blue_ketchup_1
    basket_1
  )

  (:init
    (On blue_ketchup_1 kitchen_table_blue_ketchup_init_region)
    (On wine_bottle_1 kitchen_table_wine_bottle_init_region)
    (On ketchup_1 kitchen_table_ketchup_init_region)
    (On basket_1 kitchen_table_basket_init_region)
  )

  (:goal
    (And (In blue_ketchup_1 basket_1_contain_region))
  )

)
