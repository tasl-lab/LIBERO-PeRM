(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the blue ketchup and place it in the basket)
    (:regions
      (basket_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.01 0.29 0.01 0.31)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (blue_ketchup_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.0984 -0.1731 -0.0884 -0.1631)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_alphabet_soup_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.105 -0.075 -0.095 -0.065)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (yellow_cookies_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.2178 -0.0239 -0.1678 0.0261)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    blue_ketchup_1 - blue_ketchup
    red_alphabet_soup_1 - red_alphabet_soup
    yellow_cookies_1 - yellow_cookies
    basket_1 - basket
  )

  (:obj_of_interest
    blue_ketchup_1
    basket_1
  )

  (:init
    (On blue_ketchup_1 kitchen_table_blue_ketchup_init_region)
    (On red_alphabet_soup_1 kitchen_table_red_alphabet_soup_init_region)
    (On yellow_cookies_1 kitchen_table_yellow_cookies_init_region)
    (On basket_1 kitchen_table_basket_init_region)
  )

  (:goal
    (And (In blue_ketchup_1 basket_1_contain_region))
  )

)
