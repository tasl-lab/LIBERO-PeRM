(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the blue ketchup and place it in the basket)
    (:regions
      (basket_init_region
          (:target living_room_table)
          (:ranges (
              (-0.01 0.25 0.01 0.27)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (blue_ketchup_init_region
          (:target living_room_table)
          (:ranges (
              (-0.0555 -0.1691 -0.0455 -0.1591)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_yellow_book_init_region
          (:target living_room_table)
          (:ranges (
              (0.10 -0.10 0.15 -0.05)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (green_chocolate_pudding_init_region
          (:target living_room_table)
          (:ranges (
              (-0.2523 -0.0136 -0.2023 0.0364)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (yellow_cookies_init_region
          (:target living_room_table)
          (:ranges (
              (-0.2840 -0.0882 -0.2340 -0.0382)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    blue_ketchup_1 - blue_ketchup
    red_yellow_book_1 - red_yellow_book
    green_chocolate_pudding_1 - green_chocolate_pudding
    yellow_cookies_1 - yellow_cookies
    basket_1 - basket
  )

  (:obj_of_interest
    blue_ketchup_1
    basket_1
  )

  (:init
    (On blue_ketchup_1 living_room_table_blue_ketchup_init_region)
    (On red_yellow_book_1 living_room_table_red_yellow_book_init_region)
    (On green_chocolate_pudding_1 living_room_table_green_chocolate_pudding_init_region)
    (On yellow_cookies_1 living_room_table_yellow_cookies_init_region)
    (On basket_1 living_room_table_basket_init_region)
  )

  (:goal
    (And (In blue_ketchup_1 basket_1_contain_region))
  )

)
