(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the blue ketchup and place it in the basket)
    (:regions
      (basket_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.01 0.29 0.01 0.31)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (blue_ketchup_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.0867 -0.2409 -0.0767 -0.2309)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_alphabet_soup_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.105 -0.075 -0.095 -0.065)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (macaroni_and_cheese_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.0110 0.0681 0.0390 0.1181)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    blue_ketchup_1 - blue_ketchup
    red_alphabet_soup_1 - red_alphabet_soup
    macaroni_and_cheese_1 - macaroni_and_cheese
    basket_1 - basket
  )

  (:obj_of_interest
    blue_ketchup_1
    basket_1
  )

  (:init
    (On blue_ketchup_1 kitchen_table_blue_ketchup_init_region)
    (On red_alphabet_soup_1 kitchen_table_red_alphabet_soup_init_region)
    (On macaroni_and_cheese_1 kitchen_table_macaroni_and_cheese_init_region)
    (On basket_1 kitchen_table_basket_init_region)
  )

  (:goal
    (And (In blue_ketchup_1 basket_1_contain_region))
  )

)
