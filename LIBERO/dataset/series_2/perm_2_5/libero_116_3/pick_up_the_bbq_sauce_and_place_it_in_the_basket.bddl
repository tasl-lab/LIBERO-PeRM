(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the bbq sauce and place it in the basket)
    (:regions
      (bin_region
          (:target kitchen_table)
          (:ranges (
              (-0.025 0.225 0.025 0.275)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (target_object_region
          (:target kitchen_table)
          (:ranges (
              (-0.0984 -0.1731 -0.0884 -0.1631)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_0
          (:target kitchen_table)
          (:ranges (
              (0.13 -0.10 0.18 -0.05)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_1
          (:target kitchen_table)
          (:ranges (
              (0.13 0.05 0.18 0.10)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_2
          (:target kitchen_table)
          (:ranges (
              (0.10 -0.22 0.15 -0.17)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    basket_1 - basket
    ketchup_1 - ketchup
    tomato_sauce_1 - tomato_sauce
    cream_cheese_1 - cream_cheese
  )

  (:obj_of_interest
    bbq_sauce_1
    basket_1
  )

  (:init
    (On bbq_sauce_1 kitchen_table_target_object_region)
    (On ketchup_1 kitchen_table_other_object_region_0)
    (On tomato_sauce_1 kitchen_table_other_object_region_1)
    (On cream_cheese_1 kitchen_table_other_object_region_2)
    (On basket_1 kitchen_table_bin_region)
  )

  (:goal
    (And (In bbq_sauce_1 basket_1_contain_region))
  )

)
