(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the ketchup and place it in the basket)
    (:regions
      (bin_region (:target kitchen_table) (:ranges ((-0.025 0.225 0.025 0.275))) (:yaw_rotation ((0.0 0.0))))
      (target_object_region (:target kitchen_table) (:ranges ((-0.0555 -0.1691 -0.0455 -0.1591))) (:yaw_rotation ((0.0 0.0))))
      (other_object_region_0 (:target kitchen_table) (:ranges ((0.13 -0.10 0.18 -0.05))) (:yaw_rotation ((0.0 0.0))))
      (other_object_region_1 (:target kitchen_table) (:ranges ((0.13 0.05 0.18 0.10))) (:yaw_rotation ((0.0 0.0))))
      (other_object_region_2 (:target kitchen_table) (:ranges ((0.10 -0.22 0.15 -0.17))) (:yaw_rotation ((0.0 0.0))))
      (contain_region (:target basket_1))
    )
  (:fixtures kitchen_table - kitchen_table)
  (:objects
    ketchup_1 - ketchup
    basket_1 - basket
    salad_dressing_1 - salad_dressing
    green_ketchup_1 - green_ketchup
    chocolate_pudding_1 - chocolate_pudding
  )
  (:obj_of_interest ketchup_1 basket_1)
  (:init
    (On ketchup_1 kitchen_table_target_object_region)
    (On salad_dressing_1 kitchen_table_other_object_region_0)
    (On green_ketchup_1 kitchen_table_other_object_region_1)
    (On chocolate_pudding_1 kitchen_table_other_object_region_2)
    (On basket_1 kitchen_table_bin_region)
  )
  (:goal (And (In ketchup_1 basket_1_contain_region)))
)
