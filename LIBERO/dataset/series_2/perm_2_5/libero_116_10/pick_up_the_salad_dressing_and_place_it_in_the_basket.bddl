(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language Pick the salad dressing and place it in the basket)
    (:regions
      (bin_region (:target floor) (:ranges ((-0.01 0.25 0.01 0.27))) (:yaw_rotation ((0.0 0.0))))
      (target_object_region (:target floor) (:ranges ((-0.185 -0.005 -0.175 0.005))) (:yaw_rotation ((0.0 0.0))))
      (other_object_region_0 (:target floor) (:ranges ((0.13 -0.10 0.18 -0.05))) (:yaw_rotation ((0.0 0.0))))
      (other_object_region_1 (:target floor) (:ranges ((0.13 0.05 0.18 0.10))) (:yaw_rotation ((0.0 0.0))))
      (other_object_region_2 (:target floor) (:ranges ((0.10 -0.22 0.15 -0.17))) (:yaw_rotation ((0.0 0.0))))
      (contain_region (:target basket_1))
    )
  (:fixtures floor - floor)
  (:objects
    salad_dressing_1 - salad_dressing
    basket_1 - basket
    ketchup_1 - ketchup
    bbq_sauce_1 - bbq_sauce
    cream_cheese_1 - cream_cheese
  )
  (:obj_of_interest salad_dressing_1 basket_1)
  (:init
    (On salad_dressing_1 floor_target_object_region)
    (On ketchup_1 floor_other_object_region_0)
    (On bbq_sauce_1 floor_other_object_region_1)
    (On cream_cheese_1 floor_other_object_region_2)
    (On basket_1 floor_bin_region)
  )
  (:goal (And (In salad_dressing_1 basket_1_contain_region)))
)
