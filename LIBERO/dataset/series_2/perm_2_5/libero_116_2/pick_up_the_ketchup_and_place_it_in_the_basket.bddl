(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the ketchup and place it in the basket)
    (:regions
      (bin_region (:target main_table) (:ranges ((-0.025 0.20 0.025 0.25))) (:yaw_rotation ((0.0 0.0))))
      (target_object_region (:target main_table) (:ranges ((-0.0867 -0.2409 -0.0767 -0.2309))) (:yaw_rotation ((0.0 0.0))))
      (other_object_region_0 (:target main_table) (:ranges ((0.13 -0.10 0.18 -0.05))) (:yaw_rotation ((0.0 0.0))))
      (other_object_region_1 (:target main_table) (:ranges ((0.13 0.05 0.18 0.10))) (:yaw_rotation ((0.0 0.0))))
      (other_object_region_2 (:target main_table) (:ranges ((0.10 -0.22 0.15 -0.17))) (:yaw_rotation ((0.0 0.0))))
      (contain_region (:target basket_1))
    )
  (:fixtures main_table - table)
  (:objects
    ketchup_1 - ketchup
    basket_1 - basket
    bbq_sauce_1 - bbq_sauce
    macaroni_and_cheese_1 - macaroni_and_cheese
    milk_1 - milk
  )
  (:obj_of_interest ketchup_1 basket_1)
  (:init
    (On ketchup_1 main_table_target_object_region)
    (On bbq_sauce_1 main_table_other_object_region_0)
    (On macaroni_and_cheese_1 main_table_other_object_region_1)
    (On milk_1 main_table_other_object_region_2)
    (On basket_1 main_table_bin_region)
  )
  (:goal (And (In ketchup_1 basket_1_contain_region)))
)
