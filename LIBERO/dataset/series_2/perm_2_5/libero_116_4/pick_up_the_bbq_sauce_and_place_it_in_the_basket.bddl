(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the bbq sauce and place it in the basket)
    (:regions
      (bin_region
          (:target main_table)
          (:ranges (
              (-0.025 0.2 0.025 0.25)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (target_object_region
          (:target main_table)
          (:ranges (
              (-0.0607 -0.1883 -0.0507 -0.1783)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_0
          (:target main_table)
          (:ranges (
              (0.13 -0.1 0.18 -0.05)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_1
          (:target main_table)
          (:ranges (
              (0.13 0.05 0.18 0.1)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (other_object_region_2
          (:target main_table)
          (:ranges (
              (0.1 -0.22 0.15 -0.17)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    basket_1 - basket
    yellow_milk_1 - yellow_milk
    alphabet_soup_1 - alphabet_soup
    moka_pot_1 - moka_pot
  )

  (:obj_of_interest
    bbq_sauce_1
    basket_1
  )

  (:init
    (On bbq_sauce_1 main_table_target_object_region)
    (On yellow_milk_1 main_table_other_object_region_0)
    (On alphabet_soup_1 main_table_other_object_region_1)
    (On moka_pot_1 main_table_other_object_region_2)
    (On basket_1 main_table_bin_region)
  )

  (:goal
    (And (In bbq_sauce_1 basket_1_contain_region))
  )

)
