(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the book on the left and place it on top of the shelf)
    (:regions
      (red_yellow_book_init_region
          (:target living_room_table)
          (:ranges (
              (-0.055 -0.075 -0.045 -0.065)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (green_bbq_sauce_init_region
          (:target living_room_table)
          (:ranges (
              (0.10 -0.10 0.15 -0.05)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (black_book_init_region
          (:target living_room_table)
          (:ranges (
              (0.13 0.05 0.18 0.10)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (wooden_two_layer_shelf_init_region
          (:target living_room_table)
          (:ranges (
              (-0.05 0.20 -0.03 0.22)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (top_side
          (:target wooden_two_layer_shelf_1)
      )
      (top_region
          (:target wooden_two_layer_shelf_1)
      )
      (bottom_region
          (:target wooden_two_layer_shelf_1)
      )
    )

  (:fixtures
    living_room_table - living_room_table
    wooden_two_layer_shelf_1 - wooden_two_layer_shelf
  )

  (:objects
    red_yellow_book_1 - red_yellow_book
    green_bbq_sauce_1 - green_bbq_sauce
    black_book_1 - black_book
  )

  (:obj_of_interest
    red_yellow_book_1
    wooden_two_layer_shelf_1
  )

  (:init
    (On wooden_two_layer_shelf_1 living_room_table_wooden_two_layer_shelf_init_region)
    (On red_yellow_book_1 living_room_table_red_yellow_book_init_region)
    (On green_bbq_sauce_1 living_room_table_green_bbq_sauce_init_region)
    (On black_book_1 living_room_table_black_book_init_region)
  )

  (:goal
    (And (On black_book_1 wooden_two_layer_shelf_1_top_side))
  )

)
