(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the alphabet soup and place it in the red basket)
    (:regions
      (basket_init_region
          (:target living_room_table)
          (:ranges (
              (0.10 0.25 0.12 0.27)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_basket_init_region
          (:target living_room_table)
          (:ranges (
              (-0.12 0.25 -0.10 0.27)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (alphabet_soup_init_region
          (:target living_room_table)
          (:ranges (
              (-0.005 -0.105 0.005 -0.095)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (black_book_init_region
          (:target living_room_table)
          (:ranges (
              (0.13 -0.10 0.18 -0.05)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    black_book_1 - black_book
    basket_1 - basket
    red_basket_1 - red_basket
  )

  (:obj_of_interest
    alphabet_soup_1
    red_basket_1
  )

  (:init
    (On alphabet_soup_1 living_room_table_alphabet_soup_init_region)
    (On black_book_1 living_room_table_black_book_init_region)
    (On basket_1 living_room_table_basket_init_region)
    (On red_basket_1 living_room_table_red_basket_init_region)
  )

  (:goal
    (And (In alphabet_soup_1 basket_1_contain_region))
  )

)
